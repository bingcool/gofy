// Package appio assembles one generation of IO handles and publishes it as a
// snapshot. HTTP requests are pinned by the framework: the module implements
// support.RequestBinder, so the snapshot is bound to a request only after that
// request acquired the lease of the generation this module belongs to. Scripts
// and other non-HTTP entries call Snapshot() and pin it themselves.
//
// 包 appio 组装一代 IO 句柄并发布为快照。HTTP 请求由框架固定：模块实现
// support.RequestBinder，框架只在请求拿到"本模块所属那一代"的 lease 之后才把快照固定
// 进 ctx，repository 与 service 用 WithContext(ctx) 读取；脚本等非 HTTP 入口调用
// Snapshot() 自行固定。
package appio

import (
	"context"
	"errors"

	"github.com/bingcool/gofy"
	"github.com/bingcool/gofy/support"
	appdb "{{.Module}}/app/appio/db"
)

// Module opens the named instances during startup and publishes the snapshot.
// It registers no routes: it owns connection lifetimes only.
// Module 在启动时打开命名实例并发布快照；它不注册路由，只负责连接生命周期。
type Module struct {
	rt       *gofy.Runtime
	dbCfg    map[string]gofy.DatabaseConfig
	dbOpts   []appdb.OpenOption
	set      *appdb.Set
	snapshot *Snapshot
}

// NewModuleFactory builds the module from the application runtime.
// NewModuleFactory 把实例配置封进模块工厂；每次装配由框架传入当代的 Runtime。
func NewModuleFactory(cfg map[string]gofy.DatabaseConfig, opts ...appdb.OpenOption) gofy.ModuleFactory {
	return func(rt *gofy.Runtime) (support.Module, error) {
		return NewModule(rt, cfg, opts...), nil
	}
}

// NewModule builds a module around rt and the instance configuration. The
// constructor opens nothing: connections are established in Start, so a failed
// assembly leaves no half-open pool behind.
// NewModule 用本代 Runtime 与实例配置构造模块；构造函数不建连，连接要到 Start 才建立，
// 因此装配失败不会留下半开的连接。
func NewModule(rt *gofy.Runtime, cfg map[string]gofy.DatabaseConfig, opts ...appdb.OpenOption) *Module {
	return &Module{rt: rt, dbCfg: cfg, dbOpts: opts}
}

// Name returns the module name.
// Name 返回模块名 "io"，框架用它做模块去重与错误标识。
func (m *Module) Name() string { return "io" }

// Register is a no-op: this module only publishes connection handles.
// Register 是空实现：本模块只发布连接句柄，路由由业务模块注册。
func (m *Module) Register(*support.Router) error { return nil }

// Start opens this generation's handles and publishes the snapshot once every
// instance is ready, so a request never reads a half-built generation.
// Start 打开本代句柄，全部就绪后一次发布快照，请求因此不会读到半成品。
func (m *Module) Start(ctx context.Context) error {
	if m.rt == nil {
		return errors.New("io: runtime is required")
	}
	set, err := appdb.Open(ctx, m.rt.DB, m.dbCfg, m.rt, m.dbOpts...)
	if err != nil {
		return err
	}
	m.set = set
	m.snapshot = &Snapshot{db: set}
	Publish(m.snapshot)
	return nil
}

// Snapshot returns the generation this module assembled. Non-HTTP entries pin it
// explicitly with WithSnapshot instead of reading the process-wide Current().
// Snapshot 返回本模块组装的那一代快照。非 HTTP 入口用 WithSnapshot 显式固定它，
// 而不是读进程级 Current()。
func (m *Module) Snapshot() *Snapshot { return m.snapshot }

// RequestBinder pins this generation's snapshot into every request served by
// this generation's handler. The snapshot is captured now rather than read per
// request: the module is per generation, so the captured value is exactly the
// one this generation owns.
// RequestBinder 把本代快照固定进本代 handler 处理的每个请求。快照在这里一次性捕获，
// 而不是每个请求再读一次：模块本就是"每代一个"，捕获到的值就是这一代拥有的那个。
func (m *Module) RequestBinder() support.RequestBinderFunc {
	snapshot := m.snapshot
	if snapshot == nil {
		return nil
	}
	return func(ctx context.Context) context.Context {
		return WithSnapshot(ctx, snapshot)
	}
}

// Stop withdraws the snapshot this module published and closes the instances it
// opened. Reload starts the replacement before stopping the old module, so the
// old snapshot is withdrawn only when it is still the published one.
// Stop 撤回本模块发布的快照并关闭它打开的实例。Reload 先启动新模块再停旧模块，
// 因此只撤回仍指向自己的快照。
func (m *Module) Stop(ctx context.Context) error {
	currentSnapshot.CompareAndSwap(m.snapshot, nil)
	m.snapshot = nil
	if m.set == nil {
		return nil
	}
	return m.set.Close()
}
