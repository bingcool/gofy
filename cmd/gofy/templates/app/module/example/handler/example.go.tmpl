package handler

import (
	"context"
	"strings"

	"{{.Module}}/app/module/example/dto"
)

// ExampleHandler serves the example module.
type ExampleHandler struct{}

// New builds an ExampleHandler.
func New() *ExampleHandler {
	return &ExampleHandler{}
}

// Hello returns a greeting.
func (h *ExampleHandler) Hello(_ context.Context, req *dto.HelloRequest) (*dto.HelloResponse, error) {
	name := strings.TrimSpace(req.Name)
	if name == "" {
		name = "world"
	}
	return &dto.HelloResponse{Message: "hello " + name}, nil
}
