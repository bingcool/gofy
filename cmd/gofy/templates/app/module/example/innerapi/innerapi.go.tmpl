// Package innerapi is the module's published contract for sibling modules:
// interfaces, read-only views and sentinel errors. It imports neither this
// module's service/repository/model nor HTTP types.
// 包 innerapi 是模块对其它模块发布的契约：接口、只读视图与哨兵错误。它不 import
// 本模块的 service/repository/model，也不 import HTTP 类型。
package innerapi

import (
	"context"
	"errors"
	"time"
)

// Example is the cross-module read-only view.
// Example 是跨模块只读视图。
type Example struct {
	ID        uint64
	Name      string
	CreatedAt time.Time
}

var (
	// ErrNotFound means the example does not exist.
	// ErrNotFound 表示记录不存在。
	ErrNotFound = errors.New("example not found")
	// ErrConflict means the write collided with existing data.
	// ErrConflict 表示写入与已有数据冲突。
	ErrConflict = errors.New("example conflict")
)

// ExampleAPI is what this module publishes. The service implements it; the
// assembly root passes it to any sibling that needs the capability.
// ExampleAPI 是本模块发布的能力。service 提供实现，装配根把它交给需要的兄弟模块。
type ExampleAPI interface {
	// GetExample returns one view, or ErrNotFound.
	// GetExample 返回单个视图，不存在时返回 ErrNotFound。
	GetExample(ctx context.Context, id uint64) (*Example, error)
}
