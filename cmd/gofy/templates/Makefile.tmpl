APP      := {{.Name}}
VERSION  ?= $(shell git describe --tags --always --dirty 2>/dev/null || echo dev)
COMMIT   ?= $(shell git rev-parse --short HEAD 2>/dev/null || echo none)
BUILD_AT ?= $(shell date -u +%Y-%m-%dT%H:%M:%SZ)
LDFLAGS  := -X main.version=$(VERSION) -X main.commit=$(COMMIT) -X main.buildTime=$(BUILD_AT)

.PHONY: build test fmt vet run{{if .WithScripts}} script{{end}} clean

build:
	CGO_ENABLED=0 go build -trimpath -ldflags "$(LDFLAGS)" -o bin/$(APP) .

test:
	go test -race -count=1 ./...

fmt:
	gofmt -l -w .

vet:
	go vet ./...

run:
{{- if .WithDB }}
	DB_DSN="$${DB_DSN:?set DB_DSN}" go run . start
{{- else }}
	go run . start
{{- end }}
{{- if .WithScripts }}

script:
{{- if .WithDB }}
	DB_DSN="$${DB_DSN:?set DB_DSN}" go run . script $(ARGS)
{{- else }}
	go run . script $(ARGS)
{{- end }}
{{- end }}

clean:
	rm -rf bin
