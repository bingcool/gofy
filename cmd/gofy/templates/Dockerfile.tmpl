FROM golang:{{.GoVersion}} AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG VERSION=dev
ARG COMMIT=none
ARG BUILD_AT=unknown
RUN CGO_ENABLED=0 go build -trimpath \
    -ldflags "-X main.version=${VERSION} -X main.commit=${COMMIT} -X main.buildTime=${BUILD_AT}" \
    -o /out/{{.Name}} .

FROM gcr.io/distroless/static-debian12:nonroot
WORKDIR /app
COPY --from=build /out/{{.Name}} /app/{{.Name}}
# config.yaml is the local fallback; application.yaml holds the Nacos behaviour
# and nacos.yaml the connection. Nacos itself stays disabled in this image —
# enable it per environment with NACOS_ENABLED=true, or mount a real nacos.yaml.
COPY config.yaml application.yaml nacos.yaml /app/
EXPOSE 8080
ENTRYPOINT ["/app/{{.Name}}"]
