env: dev

http:
  host: 0.0.0.0
  port: 8080
  read_header_timeout: 5s
  read_timeout: 15s
  write_timeout: 30s
  idle_timeout: 60s
  max_header_bytes: 1048576
  mode: release

log:
  level: info
  encoding: json
  outputs:
    - stdout
  base_fields:
    service: {{.Name}}
{{- if .WithDB }}

# The DSN is read from the environment; never commit credentials.
db:
  dsn: ${DB_DSN}
  max_idle_conns: 10
  max_open_conns: 50
  conn_max_lifetime: 1h
  conn_max_idle_time: 10m
  ping_timeout: 5s
  slow_threshold: 200ms
  log_level: warn
{{- end }}

pid_file: app/{{.Name}}.pid
