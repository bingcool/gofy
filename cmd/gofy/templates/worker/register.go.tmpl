package worker

import (
	gofyworker "github.com/bingcool/gofy/worker"

	"{{.Module}}/worker/group1"
)

// Register builds every group the binary knows about, in the order
// `worker --list` prints them. Adding a group means adding a package and one
// line here; nothing else in the binary changes.
// Register 构造二进制认识的所有分组，顺序与 `worker --list` 的输出一致。新增一个分组
// 只需加一个子包加这里一行，二进制其它部分不用改。
func Register() ([]*gofyworker.Group, error) {
	first, err := group1.NewGroup()
	if err != nil {
		return nil, err
	}
	return []*gofyworker.Group{first}, nil
}
