package worker

import (
	gofyworker "github.com/bingcool/gofy/support/worker"
)

// Register returns the long-running groups started by
// `go run . worker --group=default`. It is wired in main next to the HTTP
// modules and shares their config, logger and database; nothing here runs while
// the HTTP server is up.
//
// A second group is another constructor plus one entry in the returned slice:
// `worker --group=<name>` picks one at startup, so main does not change.
// Register 返回 `go run . worker --group=default` 启动的常驻分组。它在 main 里与
// HTTP 模块一起装配，共用同一份配置、日志与数据库；HTTP 服务运行时它不会启动。
//
// 第二个分组是"再写一个构造函数 + 在返回的切片里加一项"：`worker --group=<名字>`
// 在启动时选一个，main 不用改。
func Register() ([]*gofyworker.Group, error) {
	group, err := gofyworker.NewGroup("default", Example())
	if err != nil {
		return nil, err
	}
	return []*gofyworker.Group{group}, nil
}
