package worker

import (
	"context"
	"errors"
	"time"

	gofyworker "github.com/bingcool/gofy/support/worker"
)

// Example is a heartbeat worker created by the scaffold; replace the ticker
// with the real loop.
//
// Choose the primitive by the shape of the work instead of wrapping everything
// in a lease:
//   - rows waiting to be processed: claim them with support/claim, which stays
//     correct when every replica runs the loop;
//   - messages: consume them through support/worker/consumer, where the
//     consumer group already spreads the load;
//   - actions that must not run twice at all: hold a lease from support/lease
//     and pass its token to the table you write, so a paused holder's late
//     write is rejected.
//
// Example 是脚手架生成的心跳 worker，把 ticker 换成真正的循环即可。
//
// 按工作的形态挑原语，而不是所有东西都套一把锁：
//   - 待处理的行：用 support/claim 认领，所有副本同时跑也不会重复处理；
//   - 消息：用 support/worker/consumer 消费，消费组本身就会分摊负载；
//   - 绝不能执行两次的动作：用 support/lease 持有租约，并把 token 传给要写的表，
//     暂停后苏醒的旧持有者的迟到写入会被拒绝。
func Example() gofyworker.Worker {
	return gofyworker.Func("example", 1, func(ctx context.Context) error {
		rt, ok := gofyworker.RuntimeFrom(ctx)
		if !ok {
			return errors.New("worker runtime is missing from the context")
		}
		ticker := time.NewTicker(time.Minute)
		defer ticker.Stop()
		for {
			select {
			case <-ctx.Done():
				return nil
			case <-ticker.C:
				rt.Logger.Info("example worker tick")
			}
		}
	})
}
