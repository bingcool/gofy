package main

import (
	"context"
	"log"
	"os"
	"time"

	"github.com/bingcool/gofy"
	"go.uber.org/zap"

	"{{.Module}}/app/config"
{{- if .WithScripts }}
	appscript "{{.Module}}/script"
{{- end }}
	"{{.Module}}/app/module/example"
)

var (
	version   = "dev"
	commit    = "none"
	buildTime = "unknown"
)

func main() {
	ctx, stop := gofy.SignalContext(context.Background())
	defer stop()

	cfg, err := config.Load(ctx, configPath())
	if err != nil {
		log.Fatalf("load config: %v", err)
	}

	opts := []gofy.Option{
		gofy.WithName("{{.Name}}"),
		gofy.WithEnv(cfg.Env),
		gofy.WithLogConfig(cfg.Log),
		gofy.WithHTTP(cfg.HTTP),
		gofy.WithAPIPrefix("/api/v1"),
		gofy.WithPIDFile(cfg.PIDFile),
		gofy.WithHealthEndpoints(true),
		gofy.WithModuleFactories(example.NewModuleFactory()),
		gofy.WithVersionInfo(gofy.VersionInfo{
			Version:   version,
			Commit:    commit,
			BuildTime: buildTime,
		}),
		gofy.WithShutdownTimeout(10 * time.Second),
	}
{{- if .WithDB }}
	opts = append(opts, gofy.WithDatabase(cfg.DB))
{{- end }}
{{- if .WithScripts }}
	opts = append(opts, gofy.WithScripts(appscript.Register()...))
{{- end }}

	app, err := gofy.New(opts...)
	if err != nil {
		log.Fatalf("init application: %v", err)
	}

	if err := app.Execute(ctx); err != nil {
		app.Logger().Error("{{.Name}} exit", zap.Error(err))
		os.Exit(gofy.ExitCode(err))
	}
}

func configPath() string {
	if p := os.Getenv("{{.EnvPrefix}}_CONFIG"); p != "" {
		return p
	}
	return "config.yaml"
}
