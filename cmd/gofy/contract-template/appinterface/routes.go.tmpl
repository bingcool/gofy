// Package appinterface aggregates the business service contracts defined under
// appinterface/. This directory is the only extension point: every subdirectory
// describes one service (DTOs, enums, requests, responses, routes and the typed
// API client), while the rest of the module is the shared, immutable layer.
// 包 appinterface 汇总 appinterface/ 下的业务服务契约。这里是唯一的扩展点：
// 每个子目录描述一个服务（DTO、枚举、请求、响应、路由与类型化 API Client），
// 模块的其余部分是共享且不可变的底层。
package appinterface

import (
	"github.com/bingcool/gofy-interface-api/contracts/common/endpoint"
	"github.com/yourorg/interface-service/appinterface/demoservice"
)

// Routes returns the route descriptors of every registered service.
// Routes 返回所有已注册服务的路由描述符，供 docgen 生成文档、adapter 绑定路由。
func Routes() []endpoint.Descriptor {
	var out []endpoint.Descriptor
	out = append(out, demoservice.Routes()...)
	return out
}
