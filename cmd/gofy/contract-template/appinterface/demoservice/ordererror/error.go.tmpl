// Package ordererror declares the order contract errors. It is a leaf package
// so both the route descriptors and the demoservice facade can share the codes
// without an import cycle.
// 包 ordererror 声明订单契约错误。它是叶子包，路由描述符与 demoservice 门面
// 都能共享错误码而不产生 import 环。
package ordererror

import "github.com/bingcool/gofy-interface-api/contracts/common/errcode"

// Order error codes. They live in the 10000-19999 order band.
// 订单错误码，占用 10000-19999 的订单错误码段，HTTP 状态码另在 error 值中给出。
const (
	ErrCodeOrderNotFound errcode.Code = 40401
	ErrCodeOrderClosed   errcode.Code = 40402
)

var (
	// ErrOrderNotFound is returned when an order does not exist.
	// ErrOrderNotFound 订单不存在，错误码 40401，HTTP 404。
	ErrOrderNotFound = errcode.New(ErrCodeOrderNotFound, 404, "order not found")
	// ErrOrderClosed is returned when an order can no longer be cancelled.
	// ErrOrderClosed 订单已关闭、不能再取消，错误码 40402，HTTP 409。
	ErrOrderClosed = errcode.New(ErrCodeOrderClosed, 409, "order already closed")
)
