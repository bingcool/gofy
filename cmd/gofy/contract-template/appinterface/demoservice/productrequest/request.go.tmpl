// Package productrequest defines the product service requests.
// 包 productrequest 定义产品服务的请求类型。
package productrequest

import (
	"github.com/bingcool/gofy-interface-api/contracts/common/paging"
	"github.com/bingcool/gofy-interface-api/contracts/common/types"
)

// GetProductRequest queries one product.
// GetProductRequest 按 ID 查询单个产品，ID 从 URI 路径参数读取且必填。
type GetProductRequest struct {
	ID types.Uint64String `uri:"id" json:"id" form:"id" validate:"required" message:"required:产品ID不能为空" doc:"产品ID" example:"90001"`
}

// ListProductsRequest pages through products. The list includes off-sale rows;
// callers filter on the on_sale field.
// ListProductsRequest 分页查询产品，分页参数由内嵌的 paging.PageRequest 提供；
// 列表包含已下架记录，调用方按 on_sale 字段过滤。
type ListProductsRequest struct {
	paging.PageRequest
}
