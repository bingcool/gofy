// Package productdto defines the product service data transfer objects.
// 包 productdto 定义产品服务的数据传输对象（DTO），作为跨服务共享的产品视图。
package productdto

import "github.com/bingcool/gofy-interface-api/contracts/common/types"

// ProductDTO is the cross-service product representation. It mirrors the
// product module's innerapi.Product view: no timestamps, and the persistence
// status code is flattened into the boolean OnSale.
// ProductDTO 是跨服务的产品表示，对齐产品模块的 innerapi.Product 视图：不含
// 时间戳，持久层的状态码被压平为布尔字段 OnSale；价格单位为分。
type ProductDTO struct {
	ID     types.Uint64String `json:"id" doc:"产品ID" example:"90001"`
	Name   string             `json:"name" doc:"产品名称" example:"Gofy T-Shirt"`
	Price  int64              `json:"price" doc:"单价，单位：分" example:"9900"`
	Stock  int32              `json:"stock" doc:"可用库存" example:"120"`
	OnSale bool               `json:"on_sale" doc:"是否上架；下架产品仍在列表中可查，但不能下单"`
}
