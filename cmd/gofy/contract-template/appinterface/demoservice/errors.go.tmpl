package demoservice

import (
	"github.com/yourorg/interface-service/appinterface/demoservice/ordererror"
	"github.com/yourorg/interface-service/appinterface/demoservice/producterror"
)

// Order error codes and values are defined in the ordererror leaf package so the
// order routes can reference them; these aliases keep demoservice the public
// contract surface.
// 订单错误码与错误值定义在 ordererror 叶子包中，以便订单路由直接引用；这里的
// 别名让 demoservice 继续作为对外的契约面，调用方无须依赖叶子包。
const (
	ErrCodeOrderNotFound = ordererror.ErrCodeOrderNotFound
	ErrCodeOrderClosed   = ordererror.ErrCodeOrderClosed
)

var (
	// ErrOrderNotFound is returned when an order does not exist.
	// ErrOrderNotFound 订单不存在时返回，错误码 40401，HTTP 404。
	ErrOrderNotFound = ordererror.ErrOrderNotFound
	// ErrOrderClosed is returned when an order can no longer be cancelled.
	// ErrOrderClosed 订单已关闭、不能再取消时返回，错误码 40402，HTTP 409。
	ErrOrderClosed = ordererror.ErrOrderClosed
)

// Product error codes and values follow the same pattern: declared in the
// producterror leaf package, aliased here for consumers.
// 产品错误码与错误值遵循同样的模式：在 producterror 叶子包中声明，在这里别名
// 导出供调用方使用。
const (
	ErrCodeProductNotFound = producterror.ErrCodeProductNotFound
)

var (
	// ErrProductNotFound is returned when a product does not exist.
	// ErrProductNotFound 产品不存在时返回，错误码 60001，HTTP 404。
	ErrProductNotFound = producterror.ErrProductNotFound
)
