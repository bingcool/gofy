package demoservice

import (
	"github.com/bingcool/gofy-interface-api/contracts/common/endpoint"
	"github.com/yourorg/interface-service/appinterface/demoservice/orderroute"
	"github.com/yourorg/interface-service/appinterface/demoservice/productroute"
)

// Routes returns every route descriptor of the demo service, across all of its
// deployment prefixes (order and product).
// Routes 返回 demo 服务在所有部署前缀（订单与产品）下的全部路由描述符。
func Routes() []endpoint.Descriptor {
	routes := orderroute.Routes()
	return append(routes, productroute.Routes()...)
}
