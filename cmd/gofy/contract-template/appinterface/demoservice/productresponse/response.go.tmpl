// Package productresponse defines the product service responses.
// 包 productresponse 定义产品服务的响应类型。
package productresponse

import "github.com/yourorg/interface-service/appinterface/demoservice/productdto"

// GetProductResponse returns one product.
// GetProductResponse 返回单个产品详情，产品不存在时由错误信封返回 60001。
type GetProductResponse struct {
	Product *productdto.ProductDTO `json:"product" doc:"产品详情"`
}
