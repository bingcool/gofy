// Package orderconst defines order business constants shared by the contract
// and its clients.
// 包 orderconst 定义订单业务常量，供契约与调用方共享，避免魔法值散落。
package orderconst

const (
	// MaxOrderItems is the maximum number of line items per order.
	// MaxOrderItems 是单笔订单允许的最大明细行数，创建订单时按此上限校验。
	MaxOrderItems = 100

	// OrderNoPrefix prefixes generated order numbers.
	// OrderNoPrefix 是生成订单号时加的前缀，便于按前缀识别订单来源。
	OrderNoPrefix = "ORD"
)
