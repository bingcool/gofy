{
  "components": {
    "schemas": {
      "CommonEnvelope": {
        "properties": {
          "code": {
            "example": 0,
            "format": "int32",
            "type": "integer"
          },
          "details": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "msg": {
            "example": "success",
            "type": "string"
          },
          "req_id": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "msg"
        ],
        "type": "object"
      },
      "CommonErrorEnvelope": {
        "properties": {
          "code": {
            "example": 40401,
            "format": "int32",
            "type": "integer"
          },
          "data": {
            "example": null,
            "nullable": true
          },
          "details": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "msg": {
            "example": "order not found",
            "type": "string"
          },
          "req_id": {
            "example": "6f1c0b1e-7d2a-4b9c-8e1f-2a3b4c5d6e7f",
            "type": "string"
          }
        },
        "required": [
          "code",
          "msg",
          "data"
        ],
        "type": "object"
      },
      "CommonPagingListDataOfDemoserviceOrderDTO": {
        "properties": {
          "list": {
            "description": "当前页数据",
            "items": {
              "$ref": "#/components/schemas/DemoserviceOrderDTO"
            },
            "type": "array"
          },
          "total": {
            "description": "总条数",
            "example": 125,
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "list",
          "total"
        ],
        "type": "object"
      },
      "CommonPagingListDataOfDemoserviceProductDTO": {
        "properties": {
          "list": {
            "description": "当前页数据",
            "items": {
              "$ref": "#/components/schemas/DemoserviceProductDTO"
            },
            "type": "array"
          },
          "total": {
            "description": "总条数",
            "example": 125,
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "list",
          "total"
        ],
        "type": "object"
      },
      "DemoserviceCreateOrderItem": {
        "properties": {
          "num": {
            "description": "数量",
            "example": 2,
            "format": "int32",
            "maximum": 999,
            "minimum": 0,
            "type": "integer"
          },
          "sku_id": {
            "description": "SKU ID",
            "example": "90001",
            "format": "uint64",
            "type": "string"
          }
        },
        "required": [
          "num",
          "sku_id"
        ],
        "type": "object"
      },
      "DemoserviceCreateOrderRequest": {
        "properties": {
          "amount": {
            "description": "金额，单位：分",
            "example": 1999,
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "items": {
            "description": "订单明细",
            "items": {
              "$ref": "#/components/schemas/DemoserviceCreateOrderItem"
            },
            "maxItems": 100,
            "minItems": 1,
            "type": "array"
          },
          "remark": {
            "description": "备注",
            "example": "尽快发货",
            "maxLength": 255,
            "type": "string"
          },
          "user_id": {
            "description": "用户ID",
            "example": "10001",
            "format": "uint64",
            "type": "string"
          }
        },
        "required": [
          "amount",
          "items",
          "user_id"
        ],
        "type": "object"
      },
      "DemoserviceCreateOrderResponse": {
        "properties": {
          "order": {
            "allOf": [
              {
                "$ref": "#/components/schemas/DemoserviceOrderDTO"
              }
            ],
            "description": "已创建的订单",
            "nullable": true
          }
        },
        "type": "object"
      },
      "DemoserviceGetConfigResponse": {
        "properties": {
          "auth_required": {
            "description": "是否要求 Bearer Token",
            "type": "boolean"
          }
        },
        "required": [
          "auth_required"
        ],
        "type": "object"
      },
      "DemoserviceGetOrderResponse": {
        "properties": {
          "order": {
            "allOf": [
              {
                "$ref": "#/components/schemas/DemoserviceOrderDTO"
              }
            ],
            "description": "订单详情",
            "nullable": true
          }
        },
        "type": "object"
      },
      "DemoserviceGetProductResponse": {
        "properties": {
          "product": {
            "allOf": [
              {
                "$ref": "#/components/schemas/DemoserviceProductDTO"
              }
            ],
            "description": "产品详情",
            "nullable": true
          }
        },
        "type": "object"
      },
      "DemoserviceOrderDTO": {
        "properties": {
          "amount": {
            "description": "金额，单位：分",
            "example": 1999,
            "format": "int64",
            "type": "integer"
          },
          "created_at": {
            "description": "创建时间",
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "description": "订单ID",
            "example": "1234567890123456789",
            "format": "uint64",
            "type": "string"
          },
          "paid_at": {
            "description": "支付时间；未支付为 null",
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "remark": {
            "description": "备注",
            "example": "尽快发货",
            "type": "string"
          },
          "status": {
            "description": "订单状态",
            "enum": [
              "pending",
              "paid",
              "cancelled"
            ],
            "type": "string"
          },
          "user_id": {
            "description": "用户ID",
            "example": "10001",
            "format": "uint64",
            "type": "string"
          }
        },
        "required": [
          "amount",
          "created_at",
          "id",
          "status",
          "user_id"
        ],
        "type": "object"
      },
      "DemoserviceProductDTO": {
        "properties": {
          "id": {
            "description": "产品ID",
            "example": "90001",
            "format": "uint64",
            "type": "string"
          },
          "name": {
            "description": "产品名称",
            "example": "Gofy T-Shirt",
            "type": "string"
          },
          "on_sale": {
            "description": "是否上架；下架产品仍在列表中可查，但不能下单",
            "type": "boolean"
          },
          "price": {
            "description": "单价，单位：分",
            "example": 9900,
            "format": "int64",
            "type": "integer"
          },
          "stock": {
            "description": "可用库存",
            "example": 120,
            "format": "int32",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "on_sale",
          "price",
          "stock"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
